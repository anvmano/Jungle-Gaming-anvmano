{
  "info": {
    "name": "Jungle — Reversões e consultas",
    "description": "Rode os itens 01 a 19 em ordem. A coleção abre uma wallet e testa reversões e consultas. Repare no item 09. O replay do REFUND devolve os 100,00 BRL registrados na operação original, embora o saldo atual seja 20,00 BRL. Os itens 07 e 12 esperam HTTP 422.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:3001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Verificar prontidão",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Confere o resultado público desta etapa.",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const resposta = pm.response.json();",
              "pm.test(\"Dependências disponíveis\", () => pm.expect(resposta).to.eql({status:\"ok\",postgres:true,sqs:true}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Abrir wallet com 100 BRL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/wallets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"100.00\",\n    \"currency\": \"BRL\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Isola esta execução e preserva as identidades para os replays posteriores.",
              "for (const nome of [\"playerId\", \"chaveBet\", \"chaveWin\", \"chaveRollbackWin\", \"chaveRefund\", \"chaveDuplicada\", \"chaveRollbackRefund\", \"chaveOutraBet\", \"chaveRollbackBet\", \"chaveIncompativel\"]) { pm.collectionVariables.set(nome, pm.variables.replaceIn(\"{{$guid}}\")); }",
              "pm.collectionVariables.unset(\"walletId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Confere o resultado público desta etapa.",
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const resposta = pm.response.json();",
              "pm.collectionVariables.set(\"walletId\", resposta.id);",
              "pm.test(\"Saldo inicial\", () => pm.expect(resposta.balance.amount).to.eql(\"100.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — BET de 80 BRL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{chaveBet}}"
          }
        ],
        "url": "{{base}}/wagering/transactions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"providerId\": \"avaliacao-reversoes\",\n  \"externalTransactionId\": \"{{chaveBet}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"rodada-1\",\n  \"gameId\": \"jogo-1\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"80.00\",\n    \"currency\": \"BRL\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Confere o resultado público desta etapa.",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const resposta = pm.response.json();",
              "pm.test(\"Saldo 20.00 BRL\", () => pm.expect(resposta.balance).to.eql({\"amount\":\"20.00\",\"currency\":\"BRL\"}));",
              "pm.test(\"Estado da operação\", () => pm.expect(resposta.status).to.eql(\"PROCESSED\"));"
            ]
          }
        }
      ]
    },
