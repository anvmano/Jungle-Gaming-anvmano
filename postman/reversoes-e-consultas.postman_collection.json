      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verifica o estado público persistido sem reprocessar a operação.",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const resposta = pm.response.json();",
              "pm.test(\"REFUND histórico\", () => { pm.expect(resposta.kind).to.eql(\"REFUND\"); pm.expect(resposta.status).to.eql(\"PROCESSED\"); pm.expect(resposta.balance.amount).to.eql(\"100.00\"); pm.expect(resposta.referenceExternalTransactionId).to.eql(pm.collectionVariables.get(\"chaveBet\")); });",
