# Porta HTTP usada quando a aplicação roda no host.
PORTA=3000
# Conexões locais para a aplicação e as migrações.
URL_BANCO=postgresql://jungle_app:jungle_app_dev_only@127.0.0.1:5432/jungle
URL_BANCO_MIGRACOES=postgresql://jungle_admin:jungle_dev_only@127.0.0.1:5432/jungle
SENHA_BANCO_APLICACAO=jungle_app_dev_only
# Endereço local do MiniStack para a integração com SQS.
URL_SQS=http://127.0.0.1:4566
# Habilita consumidores e publicador depois de provisionar as filas locais.
MENSAGERIA_ATIVA=true
# Worker independente do SQS; prazos de referência usam o relógio do PostgreSQL.
REFERENCIAS_ATIVAS=true
REFERENCIAS_ATRASO_INICIAL_MS=1000
REFERENCIAS_ATRASO_MAXIMO_MS=60000
REFERENCIAS_TTL_MS=900000
REFERENCIAS_INTERVALO_MS=200
